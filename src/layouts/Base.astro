---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { primarySite } from '../data/seo';
const { title = 'EuroMetric | Tu dinero. Tus decisiones.', description = 'Herramientas financieras gratuitas para entender y gestionar tu economía.', noindex = false } = Astro.props;
const site = import.meta.env.PUBLIC_SITE_URL || primarySite;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const structuredData = site ? JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'EuroMetric', url: new URL('/', site).href, inLanguage: 'es-ES' }).replace(/</g, '\\u003c') : undefined;
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'}/>{canonical && <link rel="canonical" href={canonical}/>}<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/>{canonical && <meta property="og:url" content={canonical}/>} {structuredData && <script type="application/ld+json" set:html={structuredData}/>}<meta name="theme-color" content="#1e40af"/><script is:inline>try{if(localStorage.getItem('eurometric-theme')==='dark')document.documentElement.dataset.theme='dark'}catch(e){}</script></head><body>
<a class="skip-link" href="#contenido">Saltar al contenido</a><header class="site-header"><div class="container header-inner"><a class="brand" href="/" aria-label="EuroMetric, inicio"><span class="brand-mark"><Icon name="ChartNoAxesCombined" size={21}/></span><span>Euro<span>Metric</span></span></a><nav class="desktop-nav" aria-label="Navegación principal"><a href="/">Inicio</a><a href="/herramientas/">Herramientas</a><a href="/#categorias">Categorías</a><a href="/sobre-nosotros/">Sobre nosotros</a><a href="/contacto/">Contacto</a></nav><div class="header-actions"><button class="theme-toggle" type="button" aria-label="Cambiar modo claro u oscuro" title="Cambiar tema"><Icon name="Moon" size={20}/></button><details class="mobile-nav"><summary aria-label="Abrir menú"><Icon name="Menu" size={23}/></summary><nav aria-label="Navegación móvil"><a href="/">Inicio</a><a href="/herramientas/">Herramientas</a><a href="/#categorias">Categorías</a><a href="/sobre-nosotros/">Sobre nosotros</a><a href="/contacto/">Contacto y sugerencias</a></nav></details></div></div></header>
<main id="contenido"><slot /></main><footer class="footer"><div class="container"><div class="footer-top"><div><a class="brand footer-brand" href="/"><span class="brand-mark"><Icon name="ChartNoAxesCombined" size={21}/></span><span>Euro<span>Metric</span></span></a><p>Tu dinero. Tus decisiones.</p><p>Herramientas para ayudarte a entender tu economía.</p></div><div><h2>Explora</h2><a href="/herramientas/">Todas las herramientas</a><a href="/sobre-nosotros/">Sobre EuroMetric</a><a href="/contacto/">Contacto</a></div><div><h2>Información</h2><a href="/privacidad/">Política de privacidad</a><a href="/cookies/">Política de cookies</a><a href="/aviso-legal/">Aviso legal</a><a href="/descargo-responsabilidad/">Descargo de responsabilidad</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} EuroMetric</span><span>La información es orientativa y no constituye asesoramiento financiero, fiscal o legal.</span></div></div></footer>
<script>document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach(button => button.addEventListener('click', () => { const dark = document.documentElement.dataset.theme !== 'dark'; document.documentElement.dataset.theme = dark ? 'dark' : 'light'; try { localStorage.setItem('eurometric-theme', dark ? 'dark' : 'light'); } catch {} }));</script></body></html>

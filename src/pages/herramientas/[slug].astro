---
import Base from '../../layouts/Base.astro'; import Icon from '../../components/Icon.astro'; import ToolCard from '../../components/ToolCard.astro'; import { categories, tools } from '../../data/tools'; import { toolDescriptions } from '../../data/tool-descriptions'; import { shouldIndexTool } from '../../data/seo';
export function getStaticPaths(){return tools.map(tool => ({params:{slug:tool.slug},props:{tool}}));}
const { tool } = Astro.props; const category = categories.find(c=>c.slug===tool.category)!; const related = tools.filter(t=>t.category===tool.category && t.slug!==tool.slug).slice(0,3); const detail = toolDescriptions[tool.slug];
---
<Base title={`${tool.name} | EuroMetric`} description={tool.description} noindex={!shouldIndexTool(tool.slug)}><section class="page-section"><div class="container"><p class="breadcrumb"><a href="/">Inicio</a> / <a href={`/categorias/${category.slug}/`}>{category.name}</a> / {tool.name}</p><div class="eyebrow">{category.name.toUpperCase()}</div><h1>{tool.name}</h1><p class="page-lead">{tool.description}</p><div class="calculator-layout"><div><div class="calculator-panel" data-calculator data-slug={tool.slug}><noscript>Activa JavaScript para utilizar esta calculadora.</noscript></div><div class="content-block"><h2>¿Para qué sirve esta herramienta?</h2><p>{detail.purpose}</p><h2>Cómo utilizarla</h2><p>{detail.instructions}</p><h2>Cómo interpretar el resultado</h2><p>{detail.interpretation}</p><details><summary>¿Los resultados son asesoramiento profesional?</summary><p>No. Los resultados tienen carácter orientativo y no sustituyen el asesoramiento financiero, fiscal o legal adaptado a tu situación.</p></details><p class="updated">Última actualización del contenido: 25 de noviembre de 2026.</p></div></div><aside class="aside-note"><Icon name="ShieldCheck"/><h2>Tu privacidad importa</h2><p>Los cálculos se realizan en tu dispositivo y no almacenan tus datos financieros.</p></aside></div>{related.length > 0 && <div class="related"><h2>Herramientas relacionadas</h2><div class="tool-grid">{related.map(t=><ToolCard tool={t}/>)}</div></div>}</div></section><script is:inline type="module" src="/calculators.js"></script></Base>

---
import Base from '../layouts/Base.astro';
import Search from '../components/Search';
import ToolCard from '../components/ToolCard.astro';
import Icon from '../components/Icon.astro';
import { categories, tools } from '../data/tools';
const trust = [{icon:'BadgeCheck', title:'Herramientas gratuitas', text:'Información útil al alcance de todos.'},{icon:'UserRound', title:'Sin registro obligatorio', text:'Accede sin crear una cuenta.'},{icon:'ShieldCheck', title:'Privacidad de los cálculos', text:'Diseñadas para funcionar en tu dispositivo.'},{icon:'BookOpen', title:'Metodologías transparentes', text:'Explicaciones claras y fuentes contrastables.'}];
---
<Base noindex><section class="hero"><div class="container hero-inner"><div class="hero-copy"><div class="eyebrow light"><span></span> FINANZAS MÁS CLARAS</div><h1>Tu dinero.<br/>Tus decisiones.</h1><p>15 herramientas financieras gratuitas para entender y gestionar tu economía</p><Search tools={tools} client:load/><div class="hero-note"><Icon name="ShieldCheck" size={17}/> Gratis, sin registro y con privacidad</div></div><div class="hero-visual" aria-hidden="true"><div class="visual-card"><div class="visual-top"><span class="visual-icon"><Icon name="ChartNoAxesCombined" size={22}/></span><span class="visual-dots">•••</span></div><div class="visual-line long"></div><div class="visual-line short"></div><div class="visual-chart"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div><div class="visual-bottom"><span></span><span></span></div></div><div class="visual-badge"><Icon name="ShieldCheck" size={21}/> Decisiones con confianza</div></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><div class="eyebrow">EMPIEZA POR AQUÍ</div><h2>Herramientas populares</h2><p>Las calculadoras que necesitas para tus decisiones del día a día.</p></div><a class="text-link" href="/herramientas/">Ver todas las herramientas <Icon name="ArrowRight" size={17}/></a></div><div class="tool-grid">{tools.filter(t => 'popular' in t && t.popular).map(tool => <ToolCard tool={tool}/>)}</div><p class="availability"><Icon name="Info" size={17}/> Resultados orientativos calculados en tu dispositivo.</p></div></section>
<section class="section categories-section" id="categorias"><div class="container"><div class="section-heading"><div><div class="eyebrow">ENCUENTRA LO QUE BUSCAS</div><h2>Explora por categoría</h2><p>Un punto de partida para cada aspecto de tus finanzas.</p></div></div><div class="category-grid">{categories.map(category => <a class="category-card" href={`/categorias/${category.slug}/`}><span class="icon-box"><Icon name={category.icon}/></span><span><strong>{category.name}</strong><small>{category.description}</small></span><Icon name="ChevronRight" size={19}/></a>)}</div></div></section>
<section class="section trust-section"><div class="container"><div class="trust-intro"><div class="eyebrow">PENSADO PARA TI</div><h2>Decisiones con más claridad</h2><p>Queremos que entender tus finanzas sea más sencillo.</p></div><div class="trust-grid">{trust.map(item => <div><span class="trust-icon"><Icon name={item.icon}/></span><h3>{item.title}</h3><p>{item.text}</p></div>)}</div></div></section></Base>

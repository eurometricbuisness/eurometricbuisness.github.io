---
import Icon from './Icon.astro';
const { tool } = Astro.props;
---
<a class="tool-card" href={`/herramientas/${tool.slug}/`}>
  <span class="icon-box"><Icon name={tool.icon} /></span>
  <span class="card-title">{tool.name}</span>
  <span class="card-description">{tool.description}</span>
  <span class="card-link">Ver herramienta <Icon name="ArrowRight" size={16} /></span>
</a>
